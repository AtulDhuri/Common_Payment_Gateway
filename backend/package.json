{
    "name": "backend",
    "version": "1.0.0",
    "description": "Payment Hub backend",
    "main": "dist/main.js",
    "scripts": {
        "build": "nest build",
        "start": "node dist/main.js",
        "start:dev": "nest start --watch",
        "lint": "eslint src",
        "migration:run": "typeorm-ts-node-commonjs migration:run -d src/database/data-source.ts",
        "migration:revert": "typeorm-ts-node-commonjs migration:revert -d src/database/data-source.ts",
        "test": "node --require ts-node/register/transpile-only --test \"src/**/*.spec.ts\"",
        "seed": "ts-node src/database/seeds/providers.seed.ts",
        "security:verify-rls": "node -r ts-node/register/transpile-only src/database/security/verify-rls.ts"
    },
    "keywords": [],
    "author": "",
    "license": "ISC",
    "type": "commonjs",
    "dependencies": {
        "@nestjs/common": "^12.2.0",
        "@nestjs/config": "^12.0.1",
        "@nestjs/core": "^12.2.0",
        "@nestjs/jwt": "^12.0.3",
        "@nestjs/platform-express": "^12.2.0",
        "@nestjs/swagger": "^12.0.3",
        "@nestjs/typeorm": "^12.0.2",
        "bcrypt": "^6.0.0",
        "class-transformer": "^0.5.1",
        "class-validator": "^0.15.1",
        "pg": "^8.23.1",
        "razorpay": "^2.9.8",
        "reflect-metadata": "^0.2.2",
        "rxjs": "^7.8.2",
        "typeorm": "^1.1.2"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@nestjs/cli": "^12.0.10",
        "@nestjs/schematics": "^12.0.10",
        "@nestjs/testing": "^12.2.0",
        "@types/bcrypt": "^6.0.0",
        "@types/express": "^5.0.6",
        "@types/node": "^26.6.5",
        "@types/pg": "^8.23.1",
        "eslint": "^10.13.0",
        "ts-node": "^10.9.2",
        "tsconfig-paths": "^4.2.0",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.72.0"
    }
}
